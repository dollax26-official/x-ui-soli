worker_processes 1;\nevents { worker_connections 1024; }\n\nhttp {\n    server {\n        listen ${NGINX_PORT};\n\n        # ==================================================================\n        # Ù¾Ù†Ù„ 3x-ui Ø±ÙˆÛŒ Ø±ÛŒØ´Ù‡ (base path = /)\n        # ==================================================================\n\n        # ØµÙØ­Ù‡Ù” Ø§ØµÙ„ÛŒ / Ù„Ø§Ú¯ÛŒÙ†\n        location = / {\n            proxy_pass http://127.0.0.1:2053/;\n            proxy_set_header Host $host;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n        }\n\n        location = /panel { return 301 /panel/; }\n\n        # SPA Ù¾Ù†Ù„ + API Ù¾Ù†Ù„  (/panel/... Ùˆ /panel/api/...)\n        location /panel/ {\n            proxy_pass http://127.0.0.1:2053/panel/;\n            proxy_http_version 1.1;\n            proxy_set_header Upgrade $http_upgrade;\n            proxy_set_header Connection "upgrade";\n            proxy_set_header Host $host;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n        }\n\n        # Ø¯Ø§Ø±Ø§ÛŒÛŒâ€ŒÙ‡Ø§ÛŒ Ø§Ø³ØªØ§ØªÛŒÚ© Ø¨ÛŒÙ„Ø¯Ø´Ø¯Ù‡\n        location /assets/ {\n            proxy_pass http://127.0.0.1:2053/assets/;\n            proxy_set_header Host $host;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n        }\n\n        # Ø¢ÛŒÚ©ÙˆÙ†â€ŒÙ‡Ø§ÛŒ PWA\n        location /icons/ {\n            proxy_pass http://127.0.0.1:2053/icons/;\n            proxy_set_header Host $host;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n        }\n\n        # Ù…Ø³ÛŒØ±Ù‡Ø§ÛŒ Ø«Ø§Ø¨Øª Ù¾Ù†Ù„\n        location = /login              { proxy_pass http://127.0.0.1:2053/login;              proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }\n        location = /logout             { proxy_pass http://127.0.0.1:2053/logout;             proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }\n        location = /csrf-token         { proxy_pass http://127.0.0.1:2053/csrf-token;         proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }\n        location = /getTwoFactorEnable { proxy_pass http://127.0.0.1:2053/getTwoFactorEnable; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }\n        location = /manifest.webmanifest { proxy_pass http://127.0.0.1:2053/manifest.webmanifest; proxy_set_header Host $host; }\n        location = /pwa-register.js      { proxy_pass http://127.0.0.1:2053/pwa-register.js;      proxy_set_header Host $host; }\n        location = /service-worker.js    { proxy_pass http://127.0.0.1:2053/service-worker.js;    proxy_set_header Host $host; }\n        location = /favicon.ico          { proxy_pass http://127.0.0.1:2053/favicon.ico;          proxy_set_header Host $host; }\n\n        # ÙˆØ¨â€ŒØ³ÙˆÚ©Øª Ù¾Ù†Ù„ (real-time) â€” Ø§ÛŒÙ† Ù…Ø³ÛŒØ± Ø¨Ø±Ø§ÛŒ Ù¾Ù†Ù„ Ø±Ø²Ø±Ùˆ Ø§Ø³Øª\n        location = /ws {\n            proxy_pass http://127.0.0.1:2053/ws;\n            proxy_http_version 1.1;\n            proxy_set_header Upgrade $http_upgrade;\n            proxy_set_header Connection "upgrade";\n            proxy_set_header Host $host;\n            proxy_set_header X-Forwarded-Proto $scheme;\n        }\n\n        # ==================================================================\n        # Ø§Ø´ØªØ±Ø§Ú© (Subscription)\n        # ==================================================================\n        location /sub/ {\n            proxy_pass http://127.0.0.1:2096/sub/;\n            proxy_http_version 1.1;\n            proxy_set_header Host $host;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n        }\n\n        # ==================================================================\n        # Ø§ÛŒÙ†Ø¨Ø§Ù†Ø¯ VLESS/WebSocket â€” Ù‡Ø± Ù…Ø³ÛŒØ± Ø¯ÛŒÚ¯Ø±ÛŒ (catch-all)\n        # path Ø§ÛŒÙ†Ø¨Ø§Ù†Ø¯ Ø±Ø§ Ù…Ø«Ù„Ø§Ù‹ /cdn Ø¨Ú¯Ø°Ø§Ø±ÛŒØ¯ (Ù…Ø³ÛŒØ±Ù‡Ø§ÛŒ Ø¨Ø§Ù„Ø§ Ø±Ø²Ø±Ùˆ Ù‡Ø³ØªÙ†Ø¯)\n        # ==================================================================\n        location / {\n            proxy_pass http://127.0.0.1:8080;\n            proxy_http_version 1.1;\n            proxy_set_header Upgrade $http_upgrade;\n            proxy_set_header Connection "upgrade";\n            proxy_set_header Host $host;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n        }\n    }\n}\n